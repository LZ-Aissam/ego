# Hébergement sans dossier public configurable (InfinityFree) : tout le projet est dans htdocs/,
# et seul public/ est servi. /.env, /vendor ou /storage retombent sur public/ et donnent une 404.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
